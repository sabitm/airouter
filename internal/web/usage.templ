package web

import (
	"strconv"

	"airouter/internal/domain"
	"airouter/internal/usage"
)

templ UsagePage(all, shown []*domain.Provider, filter string) {
	@Layout("Usage", "/dashboard/usage") {
		<section class="panel">
			<div class="panel-head">
				<h1>Usage</h1>
				if len(shown) > 0 {
					<button
						type="button"
						class="link"
						hx-get={ usageLoadAllURL(filter) }
						hx-target="#usage-grid"
						hx-swap="outerHTML"
					>Load all</button>
				}
			</div>
			<p class="hint">Live account quota from the provider, not this router's request log.</p>
			@usageTagFilter(all, filter)
			@UsageGridIdle(all, shown)
		</section>
	}
}

templ usageFilterLink(label, value, filter string) {
	if value == filter {
		<a href={ templ.SafeURL(usageFilterURL(value)) } class="tag-filter-btn" aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(usageFilterURL(value)) } class="tag-filter-btn">{ label }</a>
	}
}

templ usageTagFilter(all []*domain.Provider, filter string) {
	if len(all) > 0 {
		<div class="tag-filter" role="group" aria-label="Filter usage by tag">
			@usageFilterLink("All", "", filter)
			for _, t := range domain.UniqueTags(all) {
				@usageFilterLink(t, t, filter)
			}
			if domain.HasUntagged(all) {
				@usageFilterLink("Untagged", usageUntaggedFilter, filter)
			}
		</div>
	}
}

templ usageCardTags(p *domain.Provider) {
	if len(p.Tags) > 0 {
		<div class="provider-tags">
			for _, t := range p.Tags {
				<span class="provider-tag">{ t }</span>
			}
		</div>
	}
}

templ UsageGridIdle(all, shown []*domain.Provider) {
	<div id="usage-grid" class="usage-grid">
		if len(all) == 0 {
			<p class="empty">No providers with a quota API. Add Codex, Claude Code, Kiro, Qoder, Antigravity, Cursor, or Grok (xAI).</p>
		} else if len(shown) == 0 {
			<p class="empty">No providers match this tag.</p>
		} else {
			for _, p := range shown {
				@UsageCardIdle(p)
			}
		}
	</div>
}

templ UsageCardIdle(p *domain.Provider) {
	<div class="usage-card" id={ "usage-card-" + strconv.FormatInt(p.ID, 10) }>
		<div class="usage-card-head">
			<div>
				<span class="usage-card-name">{ p.Name }</span>
				<span class="tag">{ string(p.Protocol) }</span>
				@usageCardTags(p)
			</div>
			<button
				type="button"
				class="link"
				hx-get={ usageCardURL(p.ID, false) }
				hx-target={ "#usage-card-" + strconv.FormatInt(p.ID, 10) }
				hx-swap="outerHTML"
			>Load</button>
		</div>
	</div>
}

templ UsageGridLoading(providers []*domain.Provider, filter string) {
	<div id="usage-grid" class="usage-grid">
		if len(providers) == 0 {
			if filter != "" {
				<p class="empty">No providers match this tag.</p>
			} else {
				<p class="empty">No providers with a quota API. Add Codex, Claude Code, Kiro, Qoder, Antigravity, Cursor, or Grok (xAI).</p>
			}
		} else {
			for _, p := range providers {
				@UsageCardSkeleton(p)
			}
		}
	</div>
}

templ UsageCardSkeleton(p *domain.Provider) {
	<div
		class="usage-card usage-card-loading"
		id={ "usage-card-" + strconv.FormatInt(p.ID, 10) }
		hx-get={ usageCardURL(p.ID, false) }
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<div class="usage-card-head">
			<div>
				<span class="usage-card-name">{ p.Name }</span>
				<span class="tag">{ string(p.Protocol) }</span>
				@usageCardTags(p)
			</div>
		</div>
		<p class="muted">loading...</p>
	</div>
}

templ UsageCard(p *domain.Provider, report *usage.Report, errMsg string) {
	<div class="usage-card" id={ "usage-card-" + strconv.FormatInt(p.ID, 10) }>
		<div class="usage-card-head">
			<div>
				<span class="usage-card-name">{ p.Name }</span>
				<span class="tag">{ string(p.Protocol) }</span>
				if report != nil && report.Plan != "" {
					<span class="usage-plan">{ report.Plan }</span>
				}
				@usageCardTags(p)
			</div>
			<button
				type="button"
				class="link"
				hx-get={ usageCardURL(p.ID, true) }
				hx-target={ "#usage-card-" + strconv.FormatInt(p.ID, 10) }
				hx-swap="outerHTML"
			>Refresh</button>
		</div>
		if errMsg != "" {
			<p class="usage-msg">{ errMsg }</p>
		} else if report != nil && report.Message != "" && len(report.Quotas) == 0 {
			<p class="usage-msg">{ report.Message }</p>
		} else if report != nil {
			if p.Protocol == domain.ProtocolOpenAICodex && report.ResetCredits > 0 {
				<p class="muted usage-reset-row">
					<span>reset credits: { strconv.Itoa(report.ResetCredits) }</span>
					<button
						type="button"
						class="link danger"
						hx-post={ usageCodexResetURL(p.ID) }
						hx-target={ "#usage-card-" + strconv.FormatInt(p.ID, 10) }
						hx-swap="outerHTML"
						hx-confirm={ "Use 1 Codex reset credit for \"" + p.Name + "\"? This cannot be undone. Remaining credits: " + strconv.Itoa(report.ResetCredits) + "." }
						hx-disabled-elt="this"
					>Reset usage</button>
				</p>
			}
			if report.Message != "" {
				<p class="usage-msg">{ report.Message }</p>
			}
			for _, q := range report.Quotas {
				@quotaRow(q)
			}
		}
	</div>
}

templ quotaRow(q usage.Quota) {
	<div class="quota-row">
		<div class="quota-row-head">
			<span class="quota-name">{ q.Name }</span>
			<span class="quota-meta">{ quotaMeta(q) }</span>
		</div>
		<div class="quota-bar" aria-hidden="true">
			<div class={ "quota-bar-fill", quotaBarClass(q) } style={ quotaBarStyle(q) }></div>
		</div>
		<div class="quota-row-foot">
			<span class="quota-used">{ quotaUsedText(q) }</span>
			<span class="quota-reset">{ formatResetCountdown(q.ResetAt) }</span>
		</div>
	</div>
}
