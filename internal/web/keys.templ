package web

import (
	"strconv"

	"airouter/internal/domain"
)

templ KeysPage(keys []*domain.AccessKey) {
	@Layout("Access Keys", "/dashboard/keys") {
		<section class="panel">
			<h1>Access Keys</h1>
			<p class="hint">Bearer tokens clients send to authenticate against the router proxy. The full token is shown only once at creation.</p>
			<form class="row-form key-form" hx-post="/dashboard/keys" hx-target="#key-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful) this.reset()">
				<label class="field key-label-field">
					<span class="field-name">Label</span>
					<input name="name" placeholder="e.g. my-laptop" required/>
				</label>
				<button type="submit">Generate</button>
			</form>
		</section>
		<section class="panel">
			@KeyList(keys, nil)
		</section>
	}
}

// KeyList renders the key table. justCreated, when non-nil, surfaces the raw
// token banner once.
templ KeyList(keys []*domain.AccessKey, justCreated *domain.AccessKey) {
	<div id="key-list">
		<div class="panel-head">
			<h2 class="section-title">Keys</h2>
			if len(keys) > 0 {
				<span class="muted">{ strconv.Itoa(len(keys)) } key(s)</span>
			}
		</div>
		@authStatusChip(len(keys))
		<div id="key-flash" class="flash-sink" aria-live="polite"></div>
		if justCreated != nil {
			<div class="flash created" role="status" aria-live="polite">
				New token (copy now, it will not be shown again):
				<div class="flash-copy">
					<code class="mono" id="created-key-token">{ justCreated.Token }</code>
					<button type="button" class="link" onclick="airouterCopyText(document.getElementById('created-key-token').textContent, this)">Copy</button>
				</div>
				<p class="field-hint">Clients send <span class="mono">Authorization: Bearer &lt;token&gt;</span>.</p>
			</div>
		}
		if len(keys) == 0 {
			<div class="flash error" role="alert">No access keys yet. The proxy is currently <strong>open</strong>: it accepts unauthenticated requests. Generate a key to require authentication.</div>
		} else {
			<table>
				<thead>
					<tr>
						<th scope="col">Label</th>
						<th scope="col">Token</th>
						<th scope="col">Created</th>
						<th scope="col"></th>
					</tr>
				</thead>
				<tbody>
					for _, k := range keys {
						<tr>
							<td>{ k.Name }</td>
							<td class="mono">{ k.Prefix }</td>
							<td>{ k.CreatedAt.Format("2006-01-02 15:04") }</td>
							<td class="actions">
								if len(keys) == 1 {
									<button class="link danger" hx-post={ "/dashboard/keys/" + strconv.FormatInt(k.ID, 10) + "/delete" } hx-target="#key-list" hx-swap="outerHTML" hx-confirm={ "Revoke the last access key \"" + k.Name + "\"? The proxy will accept unauthenticated requests until you generate another key." }>Revoke</button>
								} else {
									<button class="link danger" hx-post={ "/dashboard/keys/" + strconv.FormatInt(k.ID, 10) + "/delete" } hx-target="#key-list" hx-swap="outerHTML" hx-confirm={ "Revoke access key \"" + k.Name + "\"?" }>Revoke</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ authStatusChip(n int) {
	if n == 0 {
		<p class="auth-status auth-status-open" role="status">Open — unauthenticated requests allowed</p>
	} else {
		<p class="auth-status auth-status-protected" role="status">Protected — bearer token required</p>
	}
}
