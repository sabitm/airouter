package web

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"airouter/internal/domain"
	"airouter/internal/store"
)

type LogStats struct {
	TotalReqs int64
	TotalIn   int64
	TotalOut  int64
}

// LogFilterOpts holds distinct values for filter datalists.
type LogFilterOpts struct {
	Combos    []string
	Providers []string
}

// LogsPageMeta describes the current page of filtered log rows.
type LogsPageMeta struct {
	Page       int
	PageSize   int
	Total      int64
	TotalPages int
}

templ LogsPage(logs []*domain.RequestLog, stats LogStats, q store.RequestLogQuery, opts LogFilterOpts, meta LogsPageMeta) {
	@Layout("Logs", "/dashboard/logs") {
		@LogsBody(logs, stats, q, opts, meta)
	}
}

// LogsBody is the swappable region: stats, filters, table, and pager.
templ LogsBody(logs []*domain.RequestLog, stats LogStats, q store.RequestLogQuery, opts LogFilterOpts, meta LogsPageMeta) {
	<div id="logs-body">
		<section class="panel">
			<div class="panel-head">
				<h1>Request Logs</h1>
				if stats.TotalReqs > 0 {
					<button class="link danger" hx-post="/dashboard/logs/clear" hx-target="#logs-body" hx-swap="outerHTML" hx-confirm="Delete all request logs?">Clear logs</button>
				}
			</div>
			<p class="hint">One row per proxied attempt. Token counts are unavailable for streaming passthrough. Stats are all-time; filters apply to the table only.</p>
			<div class="stats">
				<div class="stat">
					<span class="stat-value">{ strconv.FormatInt(stats.TotalReqs, 10) }</span>
					<span class="stat-label">Requests</span>
				</div>
				<div class="stat">
					<span class="stat-value">{ strconv.FormatInt(stats.TotalIn, 10) }</span>
					<span class="stat-label">Input tokens</span>
				</div>
				<div class="stat">
					<span class="stat-value">{ strconv.FormatInt(stats.TotalOut, 10) }</span>
					<span class="stat-label">Output tokens</span>
				</div>
			</div>
		</section>
		<section class="panel">
			@LogsFilterForm(q, opts)
			@LogsTable(logs, q, meta)
		</section>
	</div>
}

templ LogsFilterForm(q store.RequestLogQuery, opts LogFilterOpts) {
	<form
		class="row-form logs-filters"
		method="get"
		action="/dashboard/logs"
		hx-get="/dashboard/logs"
		hx-target="#logs-body"
		hx-swap="outerHTML"
		hx-push-url="true"
	>
		<select name="status" title="status filter" aria-label="status filter">
			<option value="" selected?={ q.StatusClass == "" }>All statuses</option>
			<option value="error" selected?={ q.StatusClass == "error" }>Errors (4xx/5xx)</option>
			<option value="ok" selected?={ q.StatusClass == "ok" }>2xx</option>
			<option value="client" selected?={ q.StatusClass == "client" }>4xx</option>
			<option value="server" selected?={ q.StatusClass == "server" }>5xx</option>
		</select>
		<input name="combo" list="log-combo-options" value={ q.Combo } placeholder="combo" title="exact combo name" aria-label="combo filter"/>
		<datalist id="log-combo-options">
			for _, c := range opts.Combos {
				<option value={ c }></option>
			}
		</datalist>
		<input name="provider" list="log-provider-options" value={ q.Provider } placeholder="provider" title="exact provider name" aria-label="provider filter"/>
		<datalist id="log-provider-options">
			for _, p := range opts.Providers {
				<option value={ p }></option>
			}
		</datalist>
		<button type="submit">Apply</button>
		if q.Combo != "" || q.Provider != "" || q.StatusClass != "" {
			<a class="button link" href="/dashboard/logs">Clear filters</a>
		}
	</form>
}

templ LogsTable(logs []*domain.RequestLog, q store.RequestLogQuery, meta LogsPageMeta) {
	if len(logs) == 0 {
		if q.Combo != "" || q.Provider != "" || q.StatusClass != "" {
			<p class="empty">No matching requests.</p>
		} else {
			<p class="empty">No requests recorded yet.</p>
		}
	} else {
		<table class="logs-table">
			<colgroup>
				<col class="log-col-time"/>
				<col class="log-col-key"/>
				<col class="log-col-route"/>
				<col class="log-col-format"/>
				<col class="log-col-usage"/>
				<col class="log-col-latency"/>
				<col class="log-col-outcome"/>
			</colgroup>
			<thead>
				<tr>
					<th>Time</th>
					<th>Key</th>
					<th>Route</th>
					<th>Format</th>
					<th class="log-number">Usage</th>
					<th class="log-number">Latency</th>
					<th>Outcome</th>
				</tr>
			</thead>
			<tbody id="logs-tbody">
				@LogRows(logs)
			</tbody>
		</table>
		@LogsPager(q, meta)
	}
}

templ LogRows(logs []*domain.RequestLog) {
	for _, l := range logs {
		@LogRow(l)
	}
}

templ LogRow(l *domain.RequestLog) {
	<tr class="log-row" data-id={ strconv.FormatInt(l.ID, 10) }>
		<td class="log-time-cell">
			<time
				class="log-time"
				datetime={ l.CreatedAt.UTC().Format(time.RFC3339) }
				data-local-time
				title={ "UTC: " + l.CreatedAt.UTC().Format("2006-01-02 15:04:05") }
			>
				<span class="log-time-date">{ l.CreatedAt.UTC().Format("2006-01-02") }</span>
				<span class="log-time-clock">{ l.CreatedAt.UTC().Format("15:04:05") } UTC</span>
			</time>
		</td>
		<td class="log-key-cell">{ l.AccessKeyName }</td>
		<td class="log-route-cell">
			<div class="log-route-primary">
				<span>{ l.Combo }</span>
				if l.Stream {
					<span class="tag">stream</span>
				}
			</div>
			<div class="log-route-target">
				<span>{ l.Provider }</span>
				<span aria-hidden="true"> / </span>
				<span>{ l.UpstreamModel }</span>
			</div>
		</td>
		<td class="mono log-format-cell">{ l.Format }</td>
		<td
			class="log-number log-usage-cell"
			title={ "Input: " + formatLogNumber(int64(l.InputTokens)) + " tokens; Output: " + formatLogNumber(int64(l.OutputTokens)) + " tokens" }
		>
			<span><strong>{ formatLogNumber(int64(l.InputTokens)) }</strong> in</span>
			<span><strong>{ formatLogNumber(int64(l.OutputTokens)) }</strong> out</span>
		</td>
		<td class="log-number log-latency-cell" title={ formatLogNumber(l.LatencyMS) + " ms" }>
			{ formatLogLatency(l.LatencyMS) }
		</td>
		<td class="log-outcome-cell">
			@statusBadge(l.Status)
			if l.ErrMsg != "" {
				<button
					type="button"
					class="log-error-toggle"
					data-log-error-toggle
					aria-expanded="false"
					aria-controls={ logErrorID(l.ID) }
					aria-label={ "Show error details: " + truncateErr(l.ErrMsg, 120) }
				>{ truncateErr(l.ErrMsg, 48) }</button>
			}
		</td>
	</tr>
	if l.ErrMsg != "" {
		<tr id={ logErrorID(l.ID) } class="log-error-row" hidden>
			<td colspan="7">
				<div class="log-error-detail">
					<span class="log-error-detail-label">Error detail</span>
					<pre class="log-error-full">{ l.ErrMsg }</pre>
				</div>
			</td>
		</tr>
	}
}

templ LogsPager(q store.RequestLogQuery, meta LogsPageMeta) {
	if meta.Total > 0 && meta.TotalPages > 0 {
		<nav class="logs-pager" aria-label="Log pages">
			<span class="muted">{ logsShowingText(meta) }</span>
			<div class="logs-pager-nav">
				if meta.Page > 1 {
					<a
						class="link"
						href={ templ.SafeURL(logsPageURL(q, meta.Page-1)) }
						hx-get={ logsPageURL(q, meta.Page-1) }
						hx-target="#logs-body"
						hx-swap="outerHTML"
						hx-push-url="true"
					>Prev</a>
				} else {
					<span class="muted">Prev</span>
				}
				for _, item := range logsPageItems(meta.Page, meta.TotalPages) {
					if item.Ellipsis {
						<span class="muted">...</span>
					} else if item.Page == meta.Page {
						<span class="logs-pager-current" aria-current="page">{ strconv.Itoa(item.Page) }</span>
					} else {
						<a
							class="link"
							href={ templ.SafeURL(logsPageURL(q, item.Page)) }
							hx-get={ logsPageURL(q, item.Page) }
							hx-target="#logs-body"
							hx-swap="outerHTML"
							hx-push-url="true"
						>{ strconv.Itoa(item.Page) }</a>
					}
				}
				if meta.Page < meta.TotalPages {
					<a
						class="link"
						href={ templ.SafeURL(logsPageURL(q, meta.Page+1)) }
						hx-get={ logsPageURL(q, meta.Page+1) }
						hx-target="#logs-body"
						hx-swap="outerHTML"
						hx-push-url="true"
					>Next</a>
				} else {
					<span class="muted">Next</span>
				}
			</div>
		</nav>
	}
}

templ statusBadge(code int) {
	{{ class := statusClass(code) }}
	<span class={ "status", class }>{ strconv.Itoa(code) }</span>
}

func statusClass(code int) string {
	switch {
	case code >= 200 && code < 300:
		return "status-ok"
	case code >= 300 && code < 400:
		return "status-redirect"
	case code >= 400 && code < 500:
		return "status-client"
	case code >= 500:
		return "status-server"
	default:
		return "status-redirect"
	}
}

func logErrorID(id int64) string {
	return "log-error-" + strconv.FormatInt(id, 10)
}

func formatLogNumber(n int64) string {
	s := strconv.FormatInt(n, 10)
	start := 0
	if len(s) > 0 && s[0] == '-' {
		start = 1
	}
	digits := len(s) - start
	if digits <= 3 {
		return s
	}

	first := digits % 3
	if first == 0 {
		first = 3
	}
	var b strings.Builder
	b.Grow(len(s) + digits/3)
	b.WriteString(s[:start+first])
	for i := start + first; i < len(s); i += 3 {
		b.WriteByte(',')
		b.WriteString(s[i : i+3])
	}
	return b.String()
}

func formatLogLatency(ms int64) string {
	if ms < 0 {
		return strconv.FormatInt(ms, 10) + " ms"
	}
	switch {
	case ms < 1000:
		return strconv.FormatInt(ms, 10) + " ms"
	case ms < 10_000:
		return strconv.FormatFloat(float64(ms)/1000, 'f', 2, 64) + " s"
	case ms < 60_000:
		return strconv.FormatFloat(float64(ms)/1000, 'f', 1, 64) + " s"
	default:
		totalSeconds := (ms + 500) / 1000
		return strconv.FormatInt(totalSeconds/60, 10) + "m " + strconv.FormatInt(totalSeconds%60, 10) + "s"
	}
}

func truncateErr(s string, n int) string {
	runes := []rune(s)
	if n <= 0 || len(runes) <= n {
		return s
	}
	return string(runes[:n]) + "..."
}

func logsPageMeta(page, pageSize int, total int64) LogsPageMeta {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 20
	}
	meta := LogsPageMeta{Page: page, PageSize: pageSize, Total: total}
	if total <= 0 {
		return meta
	}
	pages := int((total + int64(pageSize) - 1) / int64(pageSize))
	if pages < 1 {
		pages = 1
	}
	meta.TotalPages = pages
	if meta.Page > pages {
		meta.Page = pages
	}
	return meta
}

func logsShowingText(meta LogsPageMeta) string {
	if meta.Total == 0 {
		return "No results"
	}
	start := (meta.Page-1)*meta.PageSize + 1
	end := meta.Page * meta.PageSize
	if int64(end) > meta.Total {
		end = int(meta.Total)
	}
	return "Showing " + strconv.Itoa(start) + "-" + strconv.Itoa(end) + " of " + strconv.FormatInt(meta.Total, 10)
}

// logsPageURL builds a bookmarkable logs URL for the given filters and page.
// Filters always reset implicitly when page is omitted from the filter form.
func logsPageURL(q store.RequestLogQuery, page int) string {
	v := url.Values{}
	if q.StatusClass != "" {
		v.Set("status", q.StatusClass)
	}
	if q.Combo != "" {
		v.Set("combo", q.Combo)
	}
	if q.Provider != "" {
		v.Set("provider", q.Provider)
	}
	if page > 1 {
		v.Set("page", strconv.Itoa(page))
	}
	qs := v.Encode()
	if qs == "" {
		return "/dashboard/logs"
	}
	return "/dashboard/logs?" + qs
}

type logsPageItem struct {
	Page     int
	Ellipsis bool
}

// logsPageItems returns a compact window of page numbers around current,
// always including first and last when the range is large.
func logsPageItems(current, total int) []logsPageItem {
	if total <= 0 {
		return nil
	}
	if total <= 7 {
		out := make([]logsPageItem, 0, total)
		for i := 1; i <= total; i++ {
			out = append(out, logsPageItem{Page: i})
		}
		return out
	}
	// Always: 1 … window … last
	seen := map[int]bool{}
	var pages []int
	add := func(p int) {
		if p < 1 || p > total || seen[p] {
			return
		}
		seen[p] = true
		pages = append(pages, p)
	}
	add(1)
	for p := current - 2; p <= current+2; p++ {
		add(p)
	}
	add(total)
	// sort pages (small N)
	for i := 0; i < len(pages); i++ {
		for j := i + 1; j < len(pages); j++ {
			if pages[j] < pages[i] {
				pages[i], pages[j] = pages[j], pages[i]
			}
		}
	}
	var out []logsPageItem
	prev := 0
	for _, p := range pages {
		if prev > 0 && p > prev+1 {
			out = append(out, logsPageItem{Ellipsis: true})
		}
		out = append(out, logsPageItem{Page: p})
		prev = p
	}
	return out
}
