package web

import (
	"airouter/internal/domain"
)

// oauthTokenFields renders the manual token-import inputs, prefilled from c so a
// Refresh can repopulate them. okMsg/errMsg drive the inline status. The whole
// block is a swap target: the Refresh button replaces it with the refreshed
// tokens. Initial renders pass an empty creds to avoid echoing stored secrets.
templ oauthTokenFields(c *domain.OAuthCreds, okMsg, errMsg string) {
	<div class="oauth-tokens">
		<span class="muted">Import existing tokens (optional, skips Connect):</span>
		<input name="access_token" type="password" class="oauth-cfg" placeholder="access token" aria-label="access token" value={ c.AccessToken }/>
		<input name="refresh_token" type="password" class="oauth-cfg" placeholder="refresh token" aria-label="refresh token" value={ c.RefreshToken }/>
		<input name="expires_at" class="oauth-cfg" placeholder="expires at (RFC3339 or unix seconds)" aria-label="expires at" value={ expiresAtStr(c.ExpiresAt) }/>
		<input name="email" class="oauth-cfg" placeholder="account email (optional)" aria-label="account email" value={ c.Email }/>
		<button
			type="button"
			class="link"
			hx-post="/dashboard/providers/oauth/refresh"
			hx-include="closest form"
			hx-target="closest .oauth-tokens"
			hx-swap="outerHTML"
			hx-indicator="next .refresh-indicator"
		>Refresh token</button>
		<span class="refresh-indicator htmx-indicator">refreshing...</span>
		if errMsg != "" {
			<span class="check err">{ errMsg }</span>
		} else if okMsg != "" {
			<span class="check ok">{ okMsg }</span>
		}
	</div>
}

// OAuthRefreshResult is the compact inline status for a refresh triggered from
// web-auth mode, where the full token-import fields are not shown.
templ OAuthRefreshResult(okMsg, errMsg string) {
	if errMsg != "" {
		<span class="check err">{ errMsg }</span>
	} else if okMsg != "" {
		<span class="check ok">{ okMsg }</span>
	}
}

templ KiroDeviceView(state, verificationURI, userCode string) {
	<div class="oauth-connect">
		<p class="muted">Open the AWS authorization page, sign in with your Builder ID, and approve the request. This page detects completion automatically.</p>
		<a class="button" href={ templ.SafeURL(verificationURI) } target="_blank" rel="noopener">Open authorization page</a>
		<p class="muted">Verification code: <span class="mono">{ userCode }</span></p>
		@OAuthStatusLine(state, true, "pending", "", "")
	</div>
}

templ GrokBuildDeviceView(state, verificationURI, userCode string) {
	<div class="oauth-connect">
		<p class="muted">Open the Grok Build verification page and enter the code. This page detects completion automatically.</p>
		if verificationURI != "" {
			<a class="button" href={ templ.SafeURL(verificationURI) } target="_blank" rel="noopener">Open verification page</a>
		}
		if userCode != "" {
			<p class="muted">Verification code: <span class="mono">{ userCode }</span></p>
		}
		<button
			type="button"
			class="link danger"
			hx-post="/dashboard/providers/oauth/cancel"
			hx-vals={ `{"state":"` + state + `"}` }
			hx-target="closest .oauth-region"
			hx-swap="innerHTML"
		>Cancel</button>
		@OAuthStatusLine(state, true, "pending", "", "")
	</div>
}

templ QoderDeviceView(state, verificationURI string) {
	<div class="oauth-connect">
		<p class="muted">Open the Qoder authorization page and approve the request. This page detects completion automatically.</p>
		<a class="button" href={ templ.SafeURL(verificationURI) } target="_blank" rel="noopener">Open Qoder authorization page</a>
		@OAuthStatusLine(state, true, "pending", "", "")
	</div>
}

templ OpencodeConsolePending(state, verificationURI, userCode string) {
	<div class="oauth-connect">
		<p class="muted">Open the OpenCode Console page and approve the request. This page detects completion automatically.</p>
		if verificationURI != "" {
			<a class="button" href={ templ.SafeURL(verificationURI) } target="_blank" rel="noopener">Open verification page</a>
		}
		if userCode != "" {
			<p class="muted">Verification code: <span class="mono">{ userCode }</span></p>
		}
		<button
			type="button"
			class="link danger"
			hx-post="/dashboard/providers/oauth/cancel"
			hx-vals={ `{"state":"` + state + `"}` }
			hx-target="closest .oauth-region"
			hx-swap="innerHTML"
		>Cancel</button>
		@OAuthStatusLine(state, true, "pending", "", "")
	</div>
}

templ OpencodeConsoleChoice(state, errMsg string, orgs []opencodeWorkspaceView) {
	<div id={ "oauth-status-" + state } class="oauth-connect">
		<p class="muted">Choose the OpenCode Console workspace for this connection.</p>
		if errMsg != "" {
			<p class="check err">{ errMsg }</p>
		}
		<label class="field">
			<span class="field-name">Workspace</span>
			<select name="opencode_org_choice" aria-label="OpenCode workspace">
				for _, org := range orgs {
					<option value={ org.ID }>{ org.Name }</option>
				}
			</select>
		</label>
		<button
			type="button"
			class="link"
			hx-post="/dashboard/providers/opencode/console/org"
			hx-include="closest .oauth-connect"
			hx-vals={ `{"state":"` + state + `"}` }
			hx-target={ "#oauth-status-" + state }
			hx-swap="outerHTML"
		>Use workspace</button>
	</div>
}

templ OpencodeConsoleConnected(state, workspace string) {
	<span id={ "oauth-status-" + state } class="check ok">
		if workspace != "" {
			connected to { workspace }
		} else {
			connected
		}
		<input type="hidden" name="oauth_session" value={ state }/>
	</span>
}

templ CursorConnectView(state, loginURL string) {
	<div class="oauth-connect">
		<p class="muted">Open the Cursor authorization page and approve the request. This page detects completion automatically.</p>
		<a class="button" href={ templ.SafeURL(loginURL) } target="_blank" rel="noopener">Open authorization page</a>
		<button
			type="button"
			class="link danger"
			hx-post="/dashboard/providers/oauth/cancel"
			hx-vals={ `{"state":"` + state + `"}` }
			hx-target="closest .oauth-region"
			hx-swap="innerHTML"
		>Cancel</button>
		@OAuthStatusLine(state, true, "pending", "", "")
	</div>
}

// OAuthConnectIdle is the empty connect region shown before Connect is pressed
// and after a cancel.
templ OAuthConnectIdle() {
	<span class="muted">Not connected. Fill the fields above and press Connect.</span>
}

// OAuthConnectError reports a connect setup failure (bad config) inline.
templ OAuthConnectError(msg string) {
	<span class="check err">{ msg }</span>
}

// OAuthConnectView renders the active connect region after begin: the authorize
// link to open, a manual-paste fallback, and the status line (which polls when a
// loopback callback is listening). Status element ids are scoped by the unique
// state token so a create form and an edit row can each host a connect region
// without id collisions.
templ OAuthConnectView(authURL, state string, loopback bool) {
	<div class="oauth-connect">
		<p class="muted">
			Open this link, approve access, then
			if loopback {
				return here - completion is detected automatically.
			} else {
				paste the resulting code or redirect URL below.
			}
		</p>
		<a class="button" href={ templ.SafeURL(authURL) } target="_blank" rel="noopener">Open authorize page</a>
		<div class="oauth-paste row-form">
			<input name="code" placeholder="paste code or full redirect URL" aria-label="authorization code or redirect URL"/>
			<button
				type="button"
				class="link"
				hx-post="/dashboard/providers/oauth/exchange"
				hx-include="closest .oauth-paste"
				hx-vals={ `{"state":"` + state + `"}` }
				hx-target={ "#oauth-status-" + state }
				hx-swap="outerHTML"
			>Submit code</button>
			<button
				type="button"
				class="link danger"
				hx-post="/dashboard/providers/oauth/cancel"
				hx-vals={ `{"state":"` + state + `"}` }
				hx-target="closest .oauth-region"
				hx-swap="innerHTML"
			>Cancel</button>
		</div>
		@OAuthStatusLine(state, loopback, "pending", "", "")
	</div>
}

// OAuthStatusLine is the swappable status of a connect attempt. While pending
// with a loopback listener it polls every 2s; the connected/error states omit
// the trigger so the poll stops. On success it also emits the hidden
// oauth_session input the provider form submits to claim the connected tokens.
templ OAuthStatusLine(state string, loopback bool, phase, email, errMsg string) {
	switch phase {
		case "connected":
			<span id={ "oauth-status-" + state } class="check ok">
				connected{ emailSuffix(email) }
				<input type="hidden" name="oauth_session" value={ state }/>
			</span>
		case "error":
			<span id={ "oauth-status-" + state } class="check err">{ errMsg }</span>
		default:
			if loopback {
				<span
					id={ "oauth-status-" + state }
					class="muted"
					hx-get={ "/dashboard/providers/oauth/status?state=" + state }
					hx-trigger="every 2s"
					hx-target={ "#oauth-status-" + state }
					hx-swap="outerHTML"
				>waiting for authorization...</span>
			} else {
				<span id={ "oauth-status-" + state } class="muted">waiting for pasted code...</span>
			}
	}
}

// providerCredCell renders the credential column for a provider row: the masked
// API key for apikey providers, or the connected account for oauth providers.
templ providerCredCell(p *domain.Provider) {
	if p.Method() == domain.AuthOAuth {
		<span class="tag">oauth</span> <span class="mono">{ oauthLabel(p.OAuthCreds) }</span>
	} else {
		<span class="mono">{ maskKey(p.APIKey) }</span>
	}
}

// grokBuildModeSelect selects device sign-in or a pasted token pair. Device is
// the default. The submitted values stay explicit so the backend can reject a
// mixed form instead of guessing from whichever fields happen to be present.
templ grokBuildModeSelect() {
	<label class="field">
		<span class="field-name">Sign-in method</span>
		<select name="grok_build_mode" class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
			<option value="device" selected>Device sign-in</option>
			<option value="manual">Paste tokens</option>
		</select>
	</label>
}

// grokBuildManualTokenInputs are import-only inputs. They start disabled because the
// form starts in device mode; providers.js enables the active group and disables
// the hidden one so a hidden oauth_session or token is never submitted.
templ grokBuildManualTokenInputs() {
	<div class="oauth-tokens">
		<span class="muted">Paste an access token and refresh token from the same Grok Build login. Do not share the rotating refresh token with the CLI. Public xAI API keys do not work here.</span>
		<input name="access_token" type="password" class="oauth-cfg" placeholder="access token" aria-label="access token" autocomplete="off" spellcheck="false" disabled/>
		<input name="refresh_token" type="password" class="oauth-cfg" placeholder="refresh token" aria-label="refresh token" autocomplete="off" spellcheck="false" disabled/>
		<input name="id_token" type="password" class="oauth-cfg" placeholder="id token (optional, identity only)" aria-label="id token" autocomplete="off" spellcheck="false" disabled/>
		<input name="expires_at" class="oauth-cfg" placeholder="expires at (optional, RFC3339 or unix seconds)" aria-label="expires at" autocomplete="off" spellcheck="false" disabled/>
		<span class="muted">The ID token is read locally for user or team identity and is not stored. Expiry may come from the token when left blank.</span>
	</div>
}
