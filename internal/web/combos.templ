package web

import (
	"strconv"

	"airouter/internal/domain"
)

func providerOptionLabel(p *domain.Provider) string {
	label := p.Name + " (" + string(p.Protocol) + ")"
	if p.Archived {
		label += " [archived]"
	}
	return label
}

templ CombosPage(combos []*domain.Combo, providers []*domain.Provider) {
	@Layout("Combos", "/dashboard/combos") {
		<section class="panel">
			<h1>Combos</h1>
			<p class="hint">A custom model name clients call (e.g. "default"), backed by one or more provider + upstream-model targets. With multiple targets, the strategy picks which to use: failover tries them in order, round-robin spreads load and still fails over.</p>
			<details class="routing-hint">
				<summary>How routing works</summary>
				<ul class="routing-hint-list">
					<li>Failover tries targets top-to-bottom (reorder rows to change priority).</li>
					<li>Round-robin rotates the start target, then fails over through the rest.</li>
					<li>Disabled targets and archived providers are skipped entirely.</li>
					<li>A target that fails before the response starts is temporarily deprioritized for later requests, not removed.</li>
				</ul>
			</details>
			if len(providers) == 0 {
				<p class="empty">Add a provider first.</p>
			} else {
				@comboForm(providers)
			}
		</section>
		<section class="panel">
			<div id="combo-flash" class="flash-sink" aria-live="polite"></div>
			@ComboList(combos)
		</section>
	}
}

templ comboForm(providers []*domain.Provider) {
	<form class="combo-form" hx-post="/dashboard/combos" hx-target="#combo-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful &amp;&amp; event.detail.elt === this) this.reset()">
		<div class="row-form">
			<input name="name" placeholder="combo name (e.g. default)" aria-label="combo name" required/>
			@strategySelect("")
		</div>
		<div class="targets">
			@comboTargetRow("add-0", providers, 0, "", true)
		</div>
		@targetTemplate(providers)
		<div class="row-form">
			<button type="button" class="link" onclick="addComboTarget(this)">+ Add target</button>
			<button type="submit">Add combo</button>
		</div>
	</form>
}

templ strategySelect(selected domain.ComboStrategy) {
	<select name="strategy" title="failover: try top-to-bottom; round-robin: rotate start, then fail over" aria-label="selection strategy">
		if selected == domain.StrategyRoundRobin {
			<option value="failover">failover</option>
			<option value="roundrobin" selected>round-robin</option>
		} else {
			<option value="failover" selected>failover</option>
			<option value="roundrobin">round-robin</option>
		}
	</select>
}

// comboTargetRow renders one provider + upstream-model pair. uid must be unique
// on the page so the datalist id and the htmx model-fetch target do not collide
// across rows or across open forms. DOM order of rows is the failover order.
templ comboTargetRow(uid string, providers []*domain.Provider, selectedProviderID int64, model string, enabled bool) {
	{{ listID := "model-options-" + uid }}
	{{ enabledVal := "0" }}
	{{ if enabled { enabledVal = "1" } }}
	<div class="target-row row-form">
		<label class="target-enabled" title="include in routing">
			if enabled {
				<input type="checkbox" checked onchange="airouterSetTargetEnabled(this)"/>
			} else {
				<input type="checkbox" onchange="airouterSetTargetEnabled(this)"/>
			}
			<span>On</span>
		</label>
		<input type="hidden" name="enabled" value={ enabledVal }/>
		<select name="provider_id" hx-get={ "/dashboard/providers/models?list=" + listID } hx-trigger="change, load" hx-target={ "#model-options-wrap-" + uid } hx-swap="innerHTML">
			for _, p := range providers {
				if p.ID == selectedProviderID {
					<option value={ strconv.FormatInt(p.ID, 10) } selected>{ providerOptionLabel(p) }</option>
				} else {
					<option value={ strconv.FormatInt(p.ID, 10) }>{ providerOptionLabel(p) }</option>
				}
			}
		</select>
		<input name="upstream_model" list={ listID } value={ model } placeholder="upstream model id (e.g. gpt-4o)" required/>
		<span id={ "model-options-wrap-" + uid }>@ModelOptions(nil, listID, false)</span>
		<button type="button" class="link" onclick="moveComboTarget(this, -1)" title="move earlier in failover order">Up</button>
		<button type="button" class="link" onclick="moveComboTarget(this, 1)" title="move later in failover order">Down</button>
		<button type="button" class="link danger" onclick="removeComboTarget(this)" title="remove target">x</button>
	</div>
}

// targetTemplate holds an inert prototype target row whose __IDX__ placeholders
// addComboTarget() rewrites to a unique index when cloning. Rendered with no
// selected provider so a fresh row starts blank. The <template> content is inert
// so htmx does not wire it until it is cloned into the form.
templ targetTemplate(providers []*domain.Provider) {
	<template class="target-template">
		@comboTargetRow("__IDX__", providers, 0, "", true)
	</template>
}

// ModelOptions wraps the model datalist and an optional load-failure hint.
// listID must be unique per page so the add form and each open edit row stay
// distinct. failed is true when the provider probe could not load models.
templ ModelOptions(models []string, listID string, failed bool) {
	@ModelDatalist(models, listID)
	if failed {
		<span class="field-hint">Could not load models; enter id manually.</span>
	}
}

// ModelDatalist backs an upstream_model input's autocomplete with models
// fetched live from the selected provider. An empty list just yields no
// suggestions; the field stays free-text.
templ ModelDatalist(models []string, listID string) {
	<datalist id={ listID }>
		for _, m := range models {
			<option value={ m }></option>
		}
	</datalist>
}

templ ComboList(combos []*domain.Combo) {
	<div id="combo-list">
		if len(combos) == 0 {
			<p class="empty">No combos yet.</p>
		} else {
			<table>
				<thead>
					<tr><th>Combo</th><th>Strategy</th><th>Targets</th><th></th></tr>
				</thead>
				<tbody>
					for _, c := range combos {
						@ComboRow(c)
					}
				</tbody>
			</table>
		}
	</div>
}

templ ComboRow(c *domain.Combo) {
	<tr id={ "combo-" + strconv.FormatInt(c.ID, 10) }>
		<td class="mono">{ c.Name }</td>
		<td>
			if len(c.Targets) > 1 {
				<span class="tag">{ strategyLabel(c.Strategy) }</span>
			} else {
				<span class="muted">single</span>
			}
		</td>
		<td>
			<ul class="target-list">
				for i, t := range c.Targets {
					if t.Enabled {
						<li>
							if len(c.Targets) > 1 {
								<span class="target-ord">{ strconv.Itoa(i+1) }.</span>
							}
							{ t.Provider.Name }
							<span class="tag">{ string(t.Provider.Protocol) }</span>
							<span class="mono">{ t.UpstreamModel }</span>
							<button class="link" hx-post={ "/dashboard/combos/" + strconv.FormatInt(c.ID, 10) + "/targets/" + strconv.FormatInt(t.ID, 10) + "/toggle" } hx-target={ "#combo-" + strconv.FormatInt(c.ID, 10) } hx-swap="outerHTML" title="temporarily disable this target">Disable</button>
						</li>
					} else {
						<li class="disabled">
							if len(c.Targets) > 1 {
								<span class="target-ord">{ strconv.Itoa(i+1) }.</span>
							}
							{ t.Provider.Name }
							<span class="tag">{ string(t.Provider.Protocol) }</span>
							<span class="mono">{ t.UpstreamModel }</span>
							<button class="link" hx-post={ "/dashboard/combos/" + strconv.FormatInt(c.ID, 10) + "/targets/" + strconv.FormatInt(t.ID, 10) + "/toggle" } hx-target={ "#combo-" + strconv.FormatInt(c.ID, 10) } hx-swap="outerHTML" title="re-enable this target">Enable</button>
						</li>
					}
				}
			</ul>
		</td>
		<td class="actions">
			<button class="link" hx-get={ "/dashboard/combos/" + strconv.FormatInt(c.ID, 10) + "/edit" } hx-target={ "#combo-" + strconv.FormatInt(c.ID, 10) } hx-swap="outerHTML">Edit</button>
			<button class="link" hx-get={ "/dashboard/combos/" + strconv.FormatInt(c.ID, 10) + "/swap" } hx-target={ "#combo-" + strconv.FormatInt(c.ID, 10) } hx-swap="outerHTML">Swap</button>
			<button class="link danger" hx-post={ "/dashboard/combos/" + strconv.FormatInt(c.ID, 10) + "/delete" } hx-target="#combo-list" hx-swap="outerHTML" hx-confirm={ "Delete combo \"" + c.Name + "\"?" }>Delete</button>
		</td>
	</tr>
}

func strategyLabel(s domain.ComboStrategy) string {
	if s == domain.StrategyRoundRobin {
		return "round-robin"
	}
	return "failover"
}

templ ComboEditRow(c *domain.Combo, providers []*domain.Provider) {
	{{ id := strconv.FormatInt(c.ID, 10) }}
	<tr id={ "combo-" + id }>
		<td colspan="4">
			<form class="combo-form" hx-post={ "/dashboard/combos/" + id } hx-target="#combo-list" hx-swap="outerHTML">
				<div class="row-form">
					<input name="name" value={ c.Name } aria-label="combo name" required/>
					@strategySelect(c.Strategy)
				</div>
				<div class="targets">
					for i, t := range c.Targets {
						@comboTargetRow("edit-"+id+"-"+strconv.Itoa(i), providers, t.ProviderID, t.UpstreamModel, t.Enabled)
					}
				</div>
				@targetTemplate(providers)
				<div class="row-form">
					<button type="button" class="link" onclick="addComboTarget(this)">+ Add target</button>
					<button type="submit">Save</button>
					<button type="button" class="link" hx-get={ "/dashboard/combos/" + id + "/row" } hx-target={ "#combo-" + id } hx-swap="outerHTML">Cancel</button>
				</div>
			</form>
		</td>
	</tr>
}

// ComboSwapRow replaces a combo row with a one-line form to swap its name with
// another combo's. Mirrors ComboEditRow's shape (colspan=4 tr, #combo-<id>) so
// the scroll-preservation helper still matches; success re-renders the whole
// #combo-list because ListCombos orders by name and both rows can move.
templ ComboSwapRow(c *domain.Combo, others []*domain.Combo) {
	{{ id := strconv.FormatInt(c.ID, 10) }}
	<tr id={ "combo-" + id }>
		<td colspan="4">
			<form class="combo-form" hx-post={ "/dashboard/combos/" + id + "/swap" } hx-target="#combo-list" hx-swap="outerHTML">
				<div class="row-form">
					<span>Swap name <span class="mono">{ c.Name }</span> with</span>
					if len(others) == 0 {
						<span class="muted">no other combos to swap with</span>
					} else {
						<select name="other" aria-label="combo to swap names with" required>
							<option value="" selected>select a combo...</option>
							for _, o := range others {
								<option value={ strconv.FormatInt(o.ID, 10) }>{ o.Name }</option>
							}
						</select>
						<button type="submit">Swap names</button>
					}
					<button type="button" class="link" hx-get={ "/dashboard/combos/" + id + "/row" } hx-target={ "#combo-" + id } hx-swap="outerHTML">Cancel</button>
				</div>
			</form>
		</td>
	</tr>
}
