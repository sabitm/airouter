package web

import (
	"strconv"

	"airouter/internal/domain"
)

templ ProvidersPage(providers []*domain.Provider, baseURL string) {
	@Layout("Providers", "/dashboard/providers") {
		@ConnectionPanel(baseURL)
		<section class="panel">
			<h1>Providers</h1>
			<p class="hint">An upstream connection: a base URL, an API key, and the protocol it speaks.</p>
			@providerCards()
		</section>
		<section class="panel">
			if hasOAuthProvider(providers) {
				<div class="row-form refresh-all">
					<button
						type="button"
						class="link"
						hx-post="/dashboard/providers/oauth/refresh-all"
						hx-target="#refresh-all-result"
						hx-swap="innerHTML"
						hx-indicator="#refresh-all-indicator"
					>Refresh all oauth</button>
					<span id="refresh-all-indicator" class="htmx-indicator">refreshing...</span>
					<span id="refresh-all-result"></span>
				</div>
			}
			<div id="provider-flash" class="flash-sink" aria-live="polite"></div>
			@ProviderList(providers)
		</section>
	}
}

// hasOAuthProvider reports whether any provider authenticates via oauth, gating
// the "Refresh all oauth" control so it only appears when it has work to do.
func activeProviders(ps []*domain.Provider) []*domain.Provider {
	out := make([]*domain.Provider, 0, len(ps))
	for _, p := range ps {
		if !p.Archived {
			out = append(out, p)
		}
	}
	return out
}

func archivedProviders(ps []*domain.Provider) []*domain.Provider {
	var out []*domain.Provider
	for _, p := range ps {
		if p.Archived {
			out = append(out, p)
		}
	}
	return out
}

func hasOAuthProvider(providers []*domain.Provider) bool {
	for _, p := range providers {
		if p.Method() == domain.AuthOAuth {
			return true
		}
	}
	return false
}

func providerEditInteractiveOAuth(proto domain.Protocol) bool {
	return proto == domain.ProtocolOpenAI ||
		proto == domain.ProtocolOpenAICodex ||
		proto == domain.ProtocolOpenAIResponses ||
		proto == domain.ProtocolAnthropic
}

func kiroAuthOrBuilderID(c *domain.OAuthCreds) string {
	if c == nil || c.KiroAuth == "" {
		return "builder-id"
	}
	return c.KiroAuth
}

// ConnectionPanel shows the router's own ingress URLs for agent clients. The two
// differ by design: the Anthropic SDK appends /v1/messages to its base URL, so
// it must omit /v1; OpenAI clients append /chat/completions to a base that
// already ends in /v1.
templ ConnectionPanel(baseURL string) {
	<section class="panel">
		<h1>Connect an agent</h1>
		<p class="hint">Point your agent at the router using its access key as the API key.</p>
		<div class="conn-row">
			<label>Claude Code (ANTHROPIC_BASE_URL)</label>
			<input class="mono conn-url" readonly value={ baseURL }/>
			<button type="button" class="link" onclick="airouterCopyFromPrevious(this)">Copy</button>
		</div>
		<div class="conn-row">
			<label>Codex (OPENAI_BASE_URL)</label>
			<input class="mono conn-url" readonly value={ baseURL + "/v1" }/>
			<button type="button" class="link" onclick="airouterCopyFromPrevious(this)">Copy</button>
		</div>
	</section>
}

templ providerCards() {
	<p class="hint">Choose a provider type to add.</p>
	<div class="provider-cards">
		for _, r := range recipes {
			<button
				type="button"
				class="provider-card"
				aria-pressed="false"
				aria-controls="provider-form-slot"
				onclick="airouterSelectProviderCard(this)"
				hx-get={ "/dashboard/providers/new?recipe=" + r.ID }
				hx-target="#provider-form-slot"
				hx-swap="innerHTML"
			>
				<span class="pc-label">{ r.Label }</span>
				<span class="pc-sub">{ r.Sublabel }</span>
				<span class="pc-tag">{ r.Tag }</span>
			</button>
		}
	</div>
	<div id="provider-form-slot"></div>
}

templ ProviderRecipeForm(r recipe) {
	switch r.Kind {
		case kindInteractiveOAuth:
			<form class="provider-form provider-form-grid" data-method="oauth" data-oauth-mode="web" data-protocol={ string(r.Protocol) } hx-post="/dashboard/providers" hx-target="#provider-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful &amp;&amp; event.detail.elt === this){ airouterResetProviderForm(this); airouterCloseProviderForm(); }">
				<input type="hidden" name="protocol" value={ string(r.Protocol) }/>
				<input type="hidden" name="auth_method" value="oauth"/>
				<input type="hidden" name="preset" value={ r.Preset }/>
				<label class="field">
					<span class="field-name">Name</span>
					<input name="name" placeholder="e.g. my-grok" required/>
				</label>
				<label class="field">
					<span class="field-name">Base URL</span>
					<input name="base_url" placeholder="https://api.example.com/v1" value={ r.BaseURL } required/>
				</label>
				<label class="field">
					<span class="field-name">Auth mode</span>
					<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
						<option value="web" selected>Web auth</option>
						<option value="manual">Manual</option>
					</select>
				</label>
				<div class="oauth-web">
					<button type="button" class="link" hx-post="/dashboard/providers/oauth/begin" hx-include="closest form" hx-target={ "#oauth-region-new-" + r.ID } hx-swap="innerHTML">Connect</button>
					<div id={ "oauth-region-new-" + r.ID } class="oauth-region" aria-live="polite">
						@OAuthConnectIdle()
					</div>
					<p class="field-hint">Save after Connect succeeds, or switch to Manual and paste tokens.</p>
				</div>
				<div class="oauth-manual">
					@oauthTokenFields(&domain.OAuthCreds{}, "", "")
				</div>
				<div class="form-actions">
					<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
					<span class="check-indicator htmx-indicator">checking...</span>
					<span class="check-result" aria-live="polite"></span>
					<button type="submit">Add</button>
					<button type="button" class="link" onclick="airouterCloseProviderForm()">Cancel</button>
				</div>
			</form>
		case kindKiro:
			<form class="provider-form provider-form-grid" data-method="apikey" data-oauth-mode="web" data-protocol="kiro" hx-post="/dashboard/providers" hx-target="#provider-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful &amp;&amp; event.detail.elt === this){ airouterResetProviderForm(this); airouterCloseProviderForm(); }">
				<input type="hidden" name="protocol" value="kiro"/>
				<input type="hidden" name="preset" value="kiro"/>
				<label class="field">
					<span class="field-name">Name</span>
					<input name="name" placeholder="e.g. kiro" required/>
				</label>
				<label class="field">
					<span class="field-name">Base URL</span>
					<input name="base_url" placeholder="https://api.example.com/v1" value={ r.BaseURL } required/>
				</label>
				<div class="kiro-fields">
					<label class="field">
						<span class="field-name">Profile ARN</span>
						<input name="profile_arn" class="mono" placeholder="arn:aws:codewhisperer:..."/>
					</label>
					<label class="field">
						<span class="field-name">Region</span>
						<input name="region" placeholder="default us-east-1"/>
					</label>
				</div>
				<label class="field">
					<span class="field-name">Auth method</span>
					<select name="auth_method" class="auth-method" onchange="airouterToggleAuthMethod(this)" aria-label="auth method">
						<option value="apikey">api key</option>
						<option value="oauth">AWS Builder ID (oauth)</option>
					</select>
				</label>
				<div class="apikey-fields">
					<label class="field">
						<span class="field-name">API key</span>
						<input name="api_key" type="password" placeholder="api key"/>
					</label>
				</div>
				<div class="oauth-fields">
					<label class="field">
						<span class="field-name">Auth mode</span>
						<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
							<option value="web" selected>Web auth</option>
							<option value="manual">Manual</option>
						</select>
					</label>
					<div class="oauth-web">
						<button type="button" class="link" hx-post="/dashboard/providers/kiro/device/begin" hx-include="closest form" hx-target="#oauth-region-new-kiro" hx-swap="innerHTML">Connect (AWS Builder ID)</button>
						<div id="oauth-region-new-kiro" class="oauth-region" aria-live="polite">
							@OAuthConnectIdle()
						</div>
						<p class="field-hint">Save after Connect succeeds, or switch to Manual and paste tokens.</p>
					</div>
					<div class="oauth-manual">
						<input type="hidden" name="kiro_auth" value="builder-id"/>
						<span class="muted">AWS Builder ID: paste the client id, client secret, and access/refresh tokens from your Kiro export.</span>
						<label class="field">
							<span class="field-name">Client id</span>
							<input name="client_id" class="oauth-cfg" placeholder="client id" aria-label="client id"/>
						</label>
						<label class="field">
							<span class="field-name">Client secret</span>
							<input name="client_secret" type="password" class="oauth-cfg" placeholder="client secret" aria-label="client secret"/>
						</label>
						@oauthTokenFields(&domain.OAuthCreds{}, "", "")
						<div class="form-actions">
							<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
							<span class="check-indicator htmx-indicator">checking...</span>
							<span class="check-result" aria-live="polite"></span>
						</div>
					</div>
				</div>
				<div class="form-actions">
					<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
					<span class="check-indicator htmx-indicator">checking...</span>
					<span class="check-result" aria-live="polite"></span>
					<button type="submit">Add</button>
					<button type="button" class="link" onclick="airouterCloseProviderForm()">Cancel</button>
				</div>
			</form>
		case kindQoder:
			<form class="provider-form provider-form-grid" data-method="oauth" data-oauth-mode="web" data-protocol="qoder" hx-post="/dashboard/providers" hx-target="#provider-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful &amp;&amp; event.detail.elt === this){ airouterResetProviderForm(this); airouterCloseProviderForm(); }">
				<input type="hidden" name="protocol" value="qoder"/>
				<input type="hidden" name="auth_method" value="oauth"/>
				<input type="hidden" name="preset" value="qoder"/>
				<label class="field">
					<span class="field-name">Name</span>
					<input name="name" placeholder="e.g. qoder" required/>
				</label>
				<label class="field">
					<span class="field-name">Base URL</span>
					<input name="base_url" placeholder="https://api3.qoder.sh/algo" value={ r.BaseURL } required/>
				</label>
				<label class="field">
					<span class="field-name">Auth mode</span>
					<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
						<option value="web" selected>Device auth</option>
						<option value="manual">Manual</option>
					</select>
				</label>
				<div class="oauth-web">
					<button type="button" class="link" hx-post="/dashboard/providers/qoder/device/begin" hx-include="closest form" hx-target="#oauth-region-new-qoder" hx-swap="innerHTML">Connect (Qoder)</button>
					<div id="oauth-region-new-qoder" class="oauth-region" aria-live="polite">
						@OAuthConnectIdle()
					</div>
					<p class="field-hint">Save after Connect succeeds, or switch to Manual and paste tokens.</p>
				</div>
				<div class="oauth-manual">
					<span class="muted">Paste a device access token plus the user id and machine id from a prior connect.</span>
					<label class="field">
						<span class="field-name">User id</span>
						<input name="user_id" class="oauth-cfg mono" placeholder="user id" aria-label="user id"/>
					</label>
					<label class="field">
						<span class="field-name">Machine id</span>
						<input name="machine_id" class="oauth-cfg mono" placeholder="machine uuid" aria-label="machine id"/>
					</label>
					@oauthTokenFields(&domain.OAuthCreds{}, "", "")
					<div class="form-actions">
						<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
						<span class="check-indicator htmx-indicator">checking...</span>
						<span class="check-result" aria-live="polite"></span>
					</div>
				</div>
				<div class="form-actions">
					<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
					<span class="check-indicator htmx-indicator">checking...</span>
					<span class="check-result" aria-live="polite"></span>
					<button type="submit">Add</button>
					<button type="button" class="link" onclick="airouterCloseProviderForm()">Cancel</button>
				</div>
			</form>
		case kindGenericAPIKey:
			<form class="provider-form provider-form-grid" data-method="apikey" data-protocol={ string(r.Protocol) } hx-post="/dashboard/providers" hx-target="#provider-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful &amp;&amp; event.detail.elt === this){ airouterResetProviderForm(this); airouterCloseProviderForm(); }">
				<input type="hidden" name="protocol" value={ string(r.Protocol) }/>
				<input type="hidden" name="auth_method" value="apikey"/>
				<label class="field">
					<span class="field-name">Name</span>
					<input name="name" placeholder="e.g. openrouter" required/>
				</label>
				<label class="field">
					<span class="field-name">Base URL</span>
					<input name="base_url" placeholder="https://api.example.com/v1" required/>
				</label>
				<label class="field">
					<span class="field-name">API key</span>
					<input name="api_key" type="password" placeholder="api key" required/>
				</label>
				<label class="field">
					<span class="field-name">Auth scheme</span>
					<select name="auth_scheme" title="credential header" aria-label="credential header">
						<option value="">default</option>
						<option value="bearer">bearer</option>
						<option value="x-api-key">x-api-key</option>
					</select>
				</label>
				<div class="form-actions">
					<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
					<span class="check-indicator htmx-indicator">checking...</span>
					<span class="check-result" aria-live="polite"></span>
					<button type="submit">Add</button>
					<button type="button" class="link" onclick="airouterCloseProviderForm()">Cancel</button>
				</div>
			</form>
	}
}

templ providerEditSaveCancel(p *domain.Provider) {
	<button type="submit">Save</button>
	<button type="button" class="link" hx-get={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/row" } hx-target={ "#provider-" + strconv.FormatInt(p.ID, 10) } hx-swap="outerHTML">Cancel</button>
}

templ providerEditCheck() {
	<button type="button" class="link" hx-post="/dashboard/providers/check" hx-include="closest form" hx-target="next .check-result" hx-swap="innerHTML" hx-indicator="next .check-indicator">Check</button>
	<span class="check-indicator htmx-indicator">checking...</span>
	<span class="check-result" aria-live="polite"></span>
}

templ kiroEditOAuthBlock(p *domain.Provider) {
	{{ c := orEmptyCreds(p.OAuthCreds) }}
	if p.Method() == domain.AuthOAuth {
		<span class="muted">Connected: { oauthLabel(p.OAuthCreds) }. Reconnect only if the refresh token is revoked.</span>
	}
	<input type="hidden" name="kiro_auth" value={ kiroAuthOrBuilderID(c) }/>
	<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" title="how to obtain tokens">
		<option value="web" selected>Web auth</option>
		<option value="manual">Manual</option>
	</select>
	<div class="oauth-web">
		<button type="button" class="link" hx-post="/dashboard/providers/kiro/device/begin" hx-include="closest form" hx-target={ "#oauth-region-edit-" + strconv.FormatInt(p.ID, 10) } hx-swap="innerHTML">Reconnect (AWS Builder ID)</button>
		<div id={ "oauth-region-edit-" + strconv.FormatInt(p.ID, 10) } class="oauth-region" aria-live="polite">
			@OAuthConnectIdle()
		</div>
		<button
			type="button"
			class="link"
			hx-post="/dashboard/providers/oauth/refresh"
			hx-include="closest form"
			hx-vals='{"refresh_view":"status"}'
			hx-target={ "#oauth-refresh-result-" + strconv.FormatInt(p.ID, 10) }
			hx-swap="innerHTML"
			hx-indicator="next .refresh-indicator"
		>Refresh token</button>
		<span class="refresh-indicator htmx-indicator">refreshing...</span>
		<span id={ "oauth-refresh-result-" + strconv.FormatInt(p.ID, 10) } class="oauth-refresh-result" aria-live="polite"></span>
	</div>
	<div class="oauth-manual">
		<span class="muted">AWS Builder ID: paste the client id, client secret, and access/refresh tokens from your Kiro export.</span>
		<input name="client_id" class="oauth-cfg" placeholder="client id"/>
		<input name="client_secret" type="password" class="oauth-cfg" placeholder="client secret"/>
		@oauthTokenFields(&domain.OAuthCreds{}, "", "")
		@providerEditCheck()
	</div>
}

// CheckResult reports the outcome of a connectivity check inline.
templ CheckResult(ok bool, msg string) {
	if ok {
		<span class="check ok">{ msg }</span>
	} else {
		<span class="check err">{ msg }</span>
	}
}

templ ProviderList(providers []*domain.Provider) {
	{{ active := activeProviders(providers) }}
	{{ archived := archivedProviders(providers) }}
	<div id="provider-list">
		if len(active) == 0 && len(archived) == 0 {
			<p class="empty">No providers yet.</p>
		} else {
			if len(active) > 0 {
				<table>
					<thead>
						<tr><th>Name</th><th>Base URL</th><th>API key</th><th>Protocol</th><th>Auth</th><th></th></tr>
					</thead>
					<tbody>
						for _, p := range active {
							@ProviderRow(p)
						}
					</tbody>
				</table>
			} else {
				<p class="empty">No active providers.</p>
			}
			if len(archived) > 0 {
				<div class="archived-section">
					<div class="row-form archived-head">
						<h2>Archived</h2>
						<button class="link danger" hx-post="/dashboard/providers/archived/delete-all" hx-target="#provider-list" hx-swap="outerHTML" hx-confirm="Delete all archived providers and their combos?">Delete all archived</button>
					</div>
					<table>
						<thead>
							<tr><th>Name</th><th>Base URL</th><th>API key</th><th>Protocol</th><th>Auth</th><th></th></tr>
						</thead>
						<tbody>
							for _, p := range archived {
								@ArchivedProviderRow(p)
							}
						</tbody>
					</table>
				</div>
			}
		}
	</div>
}

templ ProviderRow(p *domain.Provider) {
	<tr id={ "provider-" + strconv.FormatInt(p.ID, 10) }>
		<td>{ p.Name }</td>
		<td class="mono">{ p.BaseURL }</td>
		<td>@providerCredCell(p)</td>
		<td>{ string(p.Protocol) }</td>
		<td>{ string(p.Auth()) }</td>
		<td class="actions">
			<button class="link" hx-get={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/edit" } hx-target={ "#provider-" + strconv.FormatInt(p.ID, 10) } hx-swap="outerHTML">Edit</button>
			<button class="link" hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/archive" } hx-target="#provider-list" hx-swap="outerHTML">Archive</button>
			<button class="link danger" hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/delete" } hx-target="#provider-list" hx-swap="outerHTML" hx-confirm={ "Delete provider \"" + p.Name + "\" and its combos?" }>Delete</button>
		</td>
	</tr>
}

templ ArchivedProviderRow(p *domain.Provider) {
	<tr id={ "provider-" + strconv.FormatInt(p.ID, 10) } class="archived">
		<td>{ p.Name }</td>
		<td class="mono">{ p.BaseURL }</td>
		<td>@providerCredCell(p)</td>
		<td>{ string(p.Protocol) }</td>
		<td>{ string(p.Auth()) }</td>
		<td class="actions">
			<button class="link" hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/restore" } hx-target="#provider-list" hx-swap="outerHTML">Restore</button>
			<button class="link danger" hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) + "/delete" } hx-target="#provider-list" hx-swap="outerHTML" hx-confirm={ "Delete provider \"" + p.Name + "\" and its combos?" }>Delete</button>
		</td>
	</tr>
}

templ ProviderEditRow(p *domain.Provider) {
	<tr id={ "provider-" + strconv.FormatInt(p.ID, 10) }>
		<td colspan="6">
			if p.Protocol == domain.ProtocolKiro {
				@providerEditRowKiro(p)
			} else if p.Protocol == domain.ProtocolQoder {
				@providerEditRowQoder(p)
			} else if p.Method() == domain.AuthOAuth && providerEditInteractiveOAuth(p.Protocol) {
				@providerEditRowInteractiveOAuth(p)
			} else {
				@providerEditRowGenericAPIKey(p)
			}
		</td>
	</tr>
}

templ providerEditRowGenericAPIKey(p *domain.Provider) {
	<form class="provider-form provider-form-grid" data-method="apikey" data-protocol={ string(p.Protocol) } hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) } hx-target="#provider-list" hx-swap="outerHTML">
		<input type="hidden" name="id" value={ strconv.FormatInt(p.ID, 10) }/>
		<input type="hidden" name="protocol" value={ string(p.Protocol) }/>
		<input type="hidden" name="auth_method" value="apikey"/>
		<label class="field">
			<span class="field-name">Name</span>
			<input name="name" value={ p.Name } required/>
		</label>
		<label class="field">
			<span class="field-name">Base URL</span>
			<input name="base_url" value={ p.BaseURL } required/>
		</label>
		<label class="field">
			<span class="field-name">API key</span>
			<input name="api_key" type="password" placeholder="leave blank to keep current"/>
		</label>
		<label class="field">
			<span class="field-name">Auth scheme</span>
			<select name="auth_scheme" title="credential header" aria-label="credential header">
				if p.Auth() == domain.AuthBearer {
					<option value="bearer" selected>bearer</option>
					<option value="x-api-key">x-api-key</option>
				} else {
					<option value="bearer">bearer</option>
					<option value="x-api-key" selected>x-api-key</option>
				}
			</select>
		</label>
		<div class="form-actions">
			@providerEditCheck()
			@providerEditSaveCancel(p)
		</div>
	</form>
}

templ providerEditRowKiro(p *domain.Provider) {
	{{ c := orEmptyCreds(p.OAuthCreds) }}
	<form
		class="provider-form provider-form-grid"
		data-method={ string(p.Method()) }
		data-protocol="kiro"
		data-oauth-mode="web"
		hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) }
		hx-target="#provider-list"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="id" value={ strconv.FormatInt(p.ID, 10) }/>
		<input type="hidden" name="protocol" value="kiro"/>
		<label class="field">
			<span class="field-name">Name</span>
			<input name="name" value={ p.Name } required/>
		</label>
		<label class="field">
			<span class="field-name">Base URL</span>
			<input name="base_url" value={ p.BaseURL } required/>
		</label>
		<div class="kiro-fields">
			<label class="field">
				<span class="field-name">Profile ARN</span>
				<input name="profile_arn" class="mono" placeholder="arn:aws:codewhisperer:..." value={ c.ProfileArn }/>
			</label>
			<label class="field">
				<span class="field-name">Region</span>
				<input name="region" placeholder="default us-east-1" value={ c.Region }/>
			</label>
		</div>
		<label class="field">
			<span class="field-name">Auth method</span>
			<select name="auth_method" class="auth-method" onchange="airouterToggleAuthMethod(this)" aria-label="auth method">
				<option value="apikey" selected?={ p.Method() == domain.AuthAPIKey }>api key</option>
				<option value="oauth" selected?={ p.Method() == domain.AuthOAuth }>AWS Builder ID (oauth)</option>
			</select>
		</label>
		<div class="apikey-fields">
			<label class="field">
				<span class="field-name">API key</span>
				<input name="api_key" type="password" placeholder="leave blank to keep current"/>
			</label>
		</div>
		<div class="oauth-fields">
			@kiroEditOAuthBlock(p)
		</div>
		<div class="form-actions">
			@providerEditCheck()
			@providerEditSaveCancel(p)
		</div>
	</form>
}

templ providerEditRowQoder(p *domain.Provider) {
	{{ c := orEmptyCreds(p.OAuthCreds) }}
	<form
		class="provider-form provider-form-grid"
		data-method="oauth"
		data-protocol="qoder"
		data-oauth-mode="web"
		hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) }
		hx-target="#provider-list"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="id" value={ strconv.FormatInt(p.ID, 10) }/>
		<input type="hidden" name="protocol" value="qoder"/>
		<input type="hidden" name="auth_method" value="oauth"/>
		<input type="hidden" name="preset" value="qoder"/>
		<label class="field">
			<span class="field-name">Name</span>
			<input name="name" value={ p.Name } required/>
		</label>
		<label class="field">
			<span class="field-name">Base URL</span>
			<input name="base_url" value={ p.BaseURL } required/>
		</label>
		if c.Email != "" || c.DisplayName != "" {
			<p class="field-hint">Connected as { c.DisplayName } { c.Email }</p>
		}
		<label class="field">
			<span class="field-name">Auth mode</span>
			<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
				<option value="web" selected>Device auth</option>
				<option value="manual">Manual</option>
			</select>
		</label>
		<div class="oauth-web">
			<button type="button" class="link" hx-post="/dashboard/providers/qoder/device/begin" hx-include="closest form" hx-target={ "#oauth-region-edit-qoder-" + strconv.FormatInt(p.ID, 10) } hx-swap="innerHTML">Reconnect (Qoder)</button>
			<div id={ "oauth-region-edit-qoder-" + strconv.FormatInt(p.ID, 10) } class="oauth-region" aria-live="polite">
				@OAuthConnectIdle()
			</div>
			<p class="field-hint">Device tokens last ~30 days and cannot be refreshed. Reconnect when Check fails.</p>
		</div>
		<div class="oauth-manual">
			<label class="field">
				<span class="field-name">User id</span>
				<input name="user_id" class="oauth-cfg mono" placeholder="user id" value={ c.UserID } aria-label="user id"/>
			</label>
			<label class="field">
				<span class="field-name">Machine id</span>
				<input name="machine_id" class="oauth-cfg mono" placeholder="machine uuid" value={ c.MachineID } aria-label="machine id"/>
			</label>
			@oauthTokenFields(&domain.OAuthCreds{}, "", "")
		</div>
		<div class="form-actions">
			@providerEditCheck()
			@providerEditSaveCancel(p)
		</div>
	</form>
}

templ providerEditRowInteractiveOAuth(p *domain.Provider) {
	{{ c := orEmptyCreds(p.OAuthCreds) }}
	<form
		class="provider-form provider-form-grid"
		data-method="oauth"
		data-protocol={ string(p.Protocol) }
		data-oauth-mode="web"
		hx-post={ "/dashboard/providers/" + strconv.FormatInt(p.ID, 10) }
		hx-target="#provider-list"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="id" value={ strconv.FormatInt(p.ID, 10) }/>
		<input type="hidden" name="protocol" value={ string(p.Protocol) }/>
		<input type="hidden" name="auth_method" value="oauth"/>
		if c.Preset != "" {
			<input type="hidden" name="preset" value={ c.Preset }/>
		}
		<input type="hidden" name="auth_url" value={ c.AuthURL }/>
		<input type="hidden" name="token_url" value={ c.TokenURL }/>
		<input type="hidden" name="client_id" value={ c.ClientID }/>
		<input type="hidden" name="client_secret" value={ c.ClientSecret }/>
		<input type="hidden" name="scopes" value={ c.Scopes }/>
		<input type="hidden" name="redirect_uri" value={ redirectOr(c.RedirectURI) }/>
		<input type="hidden" name="pkce" value={ boolStr(c.PKCE) }/>
		<label class="field">
			<span class="field-name">Name</span>
			<input name="name" value={ p.Name } required/>
		</label>
		<label class="field">
			<span class="field-name">Base URL</span>
			<input name="base_url" value={ p.BaseURL } required/>
		</label>
		<span class="muted">Connected: { oauthLabel(p.OAuthCreds) }. Reconnect only if the refresh token is revoked.</span>
		<label class="field">
			<span class="field-name">Auth mode</span>
			<select class="oauth-mode" onchange="airouterToggleOAuthMode(this)" aria-label="how to obtain tokens">
				<option value="web" selected>Web auth</option>
				<option value="manual">Manual</option>
			</select>
		</label>
		<div class="oauth-web">
			<button type="button" class="link" hx-post="/dashboard/providers/oauth/begin" hx-include="closest form" hx-target={ "#oauth-region-edit-" + strconv.FormatInt(p.ID, 10) } hx-swap="innerHTML">Reconnect</button>
			<div id={ "oauth-region-edit-" + strconv.FormatInt(p.ID, 10) } class="oauth-region" aria-live="polite">
				@OAuthConnectIdle()
			</div>
			<button
				type="button"
				class="link"
				hx-post="/dashboard/providers/oauth/refresh"
				hx-include="closest form"
				hx-vals='{"refresh_view":"status"}'
				hx-target={ "#oauth-refresh-result-" + strconv.FormatInt(p.ID, 10) }
				hx-swap="innerHTML"
				hx-indicator="next .refresh-indicator"
			>Refresh token</button>
			<span class="refresh-indicator htmx-indicator">refreshing...</span>
			<span id={ "oauth-refresh-result-" + strconv.FormatInt(p.ID, 10) } class="oauth-refresh-result" aria-live="polite"></span>
		</div>
		<div class="oauth-manual">
			@oauthTokenFields(&domain.OAuthCreds{}, "", "")
			@providerEditCheck()
		</div>
		<div class="form-actions">
			@providerEditSaveCancel(p)
		</div>
	</form>
}
